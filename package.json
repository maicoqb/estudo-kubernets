{
  "name": "@estudo-kubernets/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "seed:products": "tsx --tsconfig seeds/tsconfig.json seeds/products.seed.ts",
    "test:happy-path": "docker compose -f load-tests/docker-compose.yml run --rm k6 run /scripts/happy-path.js",
    "test:high-load": "docker compose -f load-tests/docker-compose.yml run --rm k6 run /scripts/high-load.js",
    "minikube:start": "minikube start --driver=docker --memory=6144 --cpus=4",
    "k8s:deploy": "bash scripts/k8s-deploy.sh",
    "k8s:pods": "minikube kubectl -- get pods -n estore"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "^23.1.1",
    "@nx/node": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.1.1",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^1.1.0"
  }
}
